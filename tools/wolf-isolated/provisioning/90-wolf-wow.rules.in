# UNINSTALLED REVIEW PROPOSAL. No launcher command installs this file.
# inputtino fd136cfe492b4375b4507718bcca1f044588fc6f, Wolf input_handler.cpp.
# One remote domain only. Name/VID/PID select a class, NOT an allocation/lease.
# Group must be provisioned separately; desktop UID must NOT be a member.
# TAG removal does not revoke existing ACLs or already-open FDs.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Wolf X-Box One (virtual) pad", ATTRS{id/vendor}=="045e", ATTRS{id/product}=="02ea", GROUP="wolf-wow-input", MODE="0660", ENV{ID_SEAT}="seat-wolf-wow", TAG-="uaccess"
SUBSYSTEM=="input", KERNEL=="js*", ATTRS{name}=="Wolf X-Box One (virtual) pad", ATTRS{id/vendor}=="045e", ATTRS{id/product}=="02ea", GROUP="wolf-wow-input", MODE="0660", ENV{ID_SEAT}="seat-wolf-wow", TAG-="uaccess"
# Separate reviewed permission for ONLY the remote Wolf service to write uinput.
# Never grant /dev/uhid, all input nodes, or add desktop UID to input group.
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="wolf-wow-uinput", MODE="0660"
