# Additive checked Xbox API for inputtino fd136cfe492b4375b4507718bcca1f044588fc6f.
# Motion verification/composition is separately performed first by Wolf CMake.
if(NOT DEFINED INPUTTINO_SOURCE_DIR)
    message(FATAL_ERROR "INPUTTINO_SOURCE_DIR is required")
endif()
find_package(Git REQUIRED)
if(EXISTS "${INPUTTINO_SOURCE_DIR}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
                    WORKING_DIRECTORY "${INPUTTINO_SOURCE_DIR}"
                    OUTPUT_VARIABLE checked_pin OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE pin_result)
    if(NOT pin_result EQUAL 0 OR NOT checked_pin STREQUAL "fd136cfe492b4375b4507718bcca1f044588fc6f")
        message(FATAL_ERROR "Unexpected inputtino Git pin for checked Xbox")
    endif()
endif()
function(checked_xbox_hash relative expected)
    if(NOT EXISTS "${INPUTTINO_SOURCE_DIR}/${relative}")
        message(FATAL_ERROR "Missing checked Xbox prerequisite: ${relative}")
    endif()
    file(SHA256 "${INPUTTINO_SOURCE_DIR}/${relative}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Unexpected inputtino content: ${relative}")
    endif()
endfunction()
# Unchanged baseline files used by this addition (pre == post). No legacy rewrite.
checked_xbox_hash("CMakeLists.txt" "4c0b8ea309ea34cbb655f43aefcaab523adf66a1d7edad5ad4c3a68bd287eb2d")
checked_xbox_hash("include/inputtino/input.hpp" "5198ec494fc00d90b10b0cf71bc820495382ac1103626e4684d932dbbc5c85ac")
checked_xbox_hash("src/uinput/joypad_xbox.cpp" "d70ac202c8378a4a73cb47b4cf32b9990dfee2bd8d7c9504e42580a92e9c18db")
checked_xbox_hash("src/uinput/joypad_utils.hpp" "1c764e72e56c4ee88ec677811f91f1246840f147c3a50c7eeb9eaa420fb97236")
checked_xbox_hash("src/uinput/include/inputtino/protected_types.hpp" "f8cfbea8d3e46a596edb28431ef159b2f9d4077685a47f912b727ac4ea24a4d2")
set(checked_files include/inputtino/checked_xbox.hpp src/uinput/checked_xbox.cpp)
set(present 0)
foreach(relative IN LISTS checked_files)
    if(EXISTS "${INPUTTINO_SOURCE_DIR}/${relative}")
        math(EXPR present "${present} + 1")
    endif()
endforeach()
if(present EQUAL 1)
    message(FATAL_ERROR "Partial checked Xbox patch; refusing mutation")
endif()
if(present EQUAL 0)
    if(INPUTTINO_VERIFY_ONLY)
        message(FATAL_ERROR "Source override requires tracked inputtino-checked-xbox.patch; verify-only")
    endif()
    set(checked_patch "${CMAKE_CURRENT_LIST_DIR}/../patches/inputtino-checked-xbox.patch")
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "${checked_patch}"
                    WORKING_DIRECTORY "${INPUTTINO_SOURCE_DIR}" RESULT_VARIABLE checked_result)
    if(NOT checked_result EQUAL 0)
        message(FATAL_ERROR "Checked Xbox patch preflight failed")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${checked_patch}"
                    WORKING_DIRECTORY "${INPUTTINO_SOURCE_DIR}" RESULT_VARIABLE checked_result)
    if(NOT checked_result EQUAL 0)
        message(FATAL_ERROR "Checked Xbox patch failed")
    endif()
endif()
# New files: pre = ABSENT; post hashes below. Unknown/partial states fail closed.
checked_xbox_hash("include/inputtino/checked_xbox.hpp" "fb7d4a39d0418042eb17efc99f726d164991767151cfef939f4b3bac2d8545dc")
checked_xbox_hash("src/uinput/checked_xbox.cpp" "c43e894254ed43954f266bc4f13ae7bf8d2e05d9e1041e0e8053e4f75bd49aa0")
message(STATUS "Verified inputtino fd136cfe checked Xbox addition")
