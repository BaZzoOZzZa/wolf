# Pinned inputtino fd136cf security fix. Do not modify arbitrary custom sources.
# Invoke with INPUTTINO_VERIFY_ONLY=ON for source overrides; callers must apply
# the tracked patch themselves before choosing such an override.
if(NOT DEFINED INPUTTINO_SOURCE_DIR)
    message(FATAL_ERROR "INPUTTINO_SOURCE_DIR is required")
endif()
set(motion_source "${INPUTTINO_SOURCE_DIR}/src/uhid/joypad_ps5.cpp")
set(motion_header "${INPUTTINO_SOURCE_DIR}/src/uhid/motion_encoding.hpp")
set(original_hash "f4a5a170e7a39ac63ba4f61fd73d233bdb2d536ec9fa9736f8e9b904e376987e")
set(patched_hash "4a29d8b05f58c07f06366ae6d91e0d19e058f9d20710e3d20d45ae3ee8e800d1")
set(header_hash "342fe83ced8fcb7bc964757b631b86622458511aeb5e9b066708c5586034623c")
file(SHA256 "${motion_source}" actual_hash)
if(NOT actual_hash STREQUAL patched_hash)
    if(INPUTTINO_VERIFY_ONLY)
        message(FATAL_ERROR "Custom inputtino source needs the tracked patches/inputtino-signed-motion.patch; not modifying it")
    endif()
    if(NOT actual_hash STREQUAL original_hash OR EXISTS "${motion_header}")
        message(FATAL_ERROR "Unexpected inputtino source; refusing to apply the fd136cf motion patch")
    endif()
    find_package(Git REQUIRED)
    set(motion_patch "${CMAKE_CURRENT_LIST_DIR}/../patches/inputtino-signed-motion.patch")
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "${motion_patch}"
                    WORKING_DIRECTORY "${INPUTTINO_SOURCE_DIR}" RESULT_VARIABLE patch_result)
    if(NOT patch_result EQUAL 0)
        message(FATAL_ERROR "inputtino motion patch check failed")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${motion_patch}"
                    WORKING_DIRECTORY "${INPUTTINO_SOURCE_DIR}" RESULT_VARIABLE patch_result)
    if(NOT patch_result EQUAL 0)
        message(FATAL_ERROR "inputtino motion patch apply failed")
    endif()
endif()
file(SHA256 "${motion_source}" actual_hash)
file(SHA256 "${motion_header}" actual_header_hash)
if(NOT actual_hash STREQUAL patched_hash OR NOT actual_header_hash STREQUAL header_hash)
    message(FATAL_ERROR "inputtino motion source/header verification failed")
endif()
message(STATUS "Verified inputtino fd136cf signed-motion patch")
