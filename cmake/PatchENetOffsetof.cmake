# Narrow correction for pinned ENet null-base offsetof idiom; no wire/layout change.
if(NOT DEFINED ENET_SOURCE_DIR)
    message(FATAL_ERROR "ENET_SOURCE_DIR is required")
endif()
find_package(Git REQUIRED)
if(EXISTS "${ENET_SOURCE_DIR}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
                    WORKING_DIRECTORY "${ENET_SOURCE_DIR}"
                    OUTPUT_VARIABLE pin OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT pin STREQUAL "44c85e16279553d9c052e572bcbfcd745fb74abf")
        message(FATAL_ERROR "Unexpected ENet Git pin")
    endif()
endif()
set(patch "${CMAKE_CURRENT_LIST_DIR}/patches/enet-offsetof.patch")
file(SHA256 "${patch}" patch_hash)
if(NOT patch_hash STREQUAL "6441d03d0fae5e00e0e8ef0830c0587954c3f57cf4a59141977ff8a3278fad42")
    message(FATAL_ERROR "Unexpected ENet tracked patch content")
endif()
if(DEFINED ENET_PATCH_REVISION AND NOT ENET_PATCH_REVISION STREQUAL patch_hash)
    message(FATAL_ERROR "ENet patch revision argument mismatch")
endif()
# Archive fixtures use exact pinned content hashes; actual FetchContent also checks Git HEAD.
if(NOT EXISTS "${ENET_SOURCE_DIR}/protocol.c" OR NOT EXISTS "${ENET_SOURCE_DIR}/include/enet/protocol.h")
    message(FATAL_ERROR "Missing ENet prerequisite")
endif()
file(SHA256 "${ENET_SOURCE_DIR}/include/enet/protocol.h" layout_hash)
if(NOT layout_hash STREQUAL "e135dfbd0fd2cf60d9b5f92cc3ed7ce4f6fa2e46e5281915380437dc3c255159")
    message(FATAL_ERROR "Unexpected ENet wire layout header; refusing mutation")
endif()
file(SHA256 "${ENET_SOURCE_DIR}/protocol.c" content)
if(content STREQUAL "589881fa1117713e380303a04b312e8930f1f2539bfdec44ee8991a782882925")
    message(STATUS "Verified pinned ENet offsetof correction (already applied)")
    return()
endif()
if(NOT content STREQUAL "c35cf3ad3f0e26a5797c1375ea8779a5aed8eab0f9ee2efc8f18dc1d1f4d6bf2")
    message(FATAL_ERROR "Unknown/partial ENet protocol.c; refusing mutation")
endif()
if(ENET_VERIFY_ONLY)
    message(FATAL_ERROR "ENet source override requires tracked offsetof correction; verify-only")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "${patch}"
                WORKING_DIRECTORY "${ENET_SOURCE_DIR}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "ENet offsetof patch preflight failed")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${patch}"
                WORKING_DIRECTORY "${ENET_SOURCE_DIR}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "ENet offsetof patch failed")
endif()
file(SHA256 "${ENET_SOURCE_DIR}/protocol.c" content)
if(NOT content STREQUAL "589881fa1117713e380303a04b312e8930f1f2539bfdec44ee8991a782882925")
    message(FATAL_ERROR "ENet offsetof patched hash mismatch")
endif()
message(STATUS "Verified pinned ENet offsetof correction")
