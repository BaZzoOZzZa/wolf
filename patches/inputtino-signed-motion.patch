@@ -0,0 +1,24 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <endian.h>
+#include <limits>
+
+namespace inputtino::detail {
+
+// Private report encoding, also exercised without constructing a device.
+// Invalid samples become neutral; finite samples saturate to the signed wire
+// range. Scale in double to avoid overflow for even FLT_MAX sensor input.
+inline uint16_t motion_to_le(float sample, double scale) {
+  if (!std::isfinite(sample))
+    return htole16(uint16_t{0});
+  const auto scaled = std::clamp(static_cast<double>(sample) * scale,
+                               static_cast<double>(std::numeric_limits<int16_t>::min()),
+                               static_cast<double>(std::numeric_limits<int16_t>::max()));
+  const auto signed_value = static_cast<int16_t>(scaled);
+  return htole16(static_cast<uint16_t>(signed_value));
+}
+
+} // namespace inputtino::detail
